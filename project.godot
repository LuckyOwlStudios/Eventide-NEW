[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Players"
3d_physics/layer_3="Creatures"
3d_physics/layer_4="Vehicles"
3d_physics/layer_5="Vehicle Interiors"
3d_physics/layer_6="Items"
3d_physics/layer_7="Interactables"
3d_physics/layer_8="Projectiles"
3d_physics/layer_9="Gravity Fields"
