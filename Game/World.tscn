[sub_resource type="GDScript" id="GDScript_uyedj"]
script/source = "extends Node3D

@export var mesh: CSGPrimitive3D

@onready var interactable: InteractableObject3D = $InteractableObject3D

func _ready() -> void:
	interactable.interacted.connect(_interacted)

func _interacted(interactor: Node3D):
	var material: Material = mesh.material
	if material.get(\"albedo_color\") == Color.RED:
		mesh.material.set(\"albedo_color\", Color.GREEN)
	else:
		mesh.material.set(\"albedo_color\", Color.RED)
"

