; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Eventide"
run/main_scene="uid://ctpvbs2u3kpet"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

driver/output_latency=10
driver/enable_input=true

[autoload]

SteamNetwork="*res://Game/AutoLoads/steam_network.gd"
VoiceChannels="*res://Components/VoiceChat/voice_channels.gd"
InGameHandler="*uid://ddqkguh4agyga"
Settings="*res://Game/AutoLoads/settings.gd"
NetworkSession="*res://Game/AutoLoads/network_session.gd"
InGameUIHandler="*res://Assets/Themes/InGameUIHandler.tscn"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/default_gravity=16.0

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d-1.7.3/addons/debug_draw_3d"

[display]

window/size/viewport_width=1980
window/size/viewport_height=1080
window/size/mode=2
window/size/borderless=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/curved_raycast_3d/plugin.cfg", "res://addons/ladder_3d/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "pink",
"res://Components/": "yellow",
"res://Game/": "green",
"res://Scenes/": "blue",
"res://Testing/": "orange",
"res://addons/": "gray"
}

[global_group]

gameplay_scene="A root scene responsible for holding gameplay inside"

[gui]

theme/custom="res://Assets/Themes/game_theme.tres"
theme/custom_font="uid://lcpnisqt6ivn"

